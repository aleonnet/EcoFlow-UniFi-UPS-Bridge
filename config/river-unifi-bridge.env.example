# river-unifi-bridge — configuração (comentário só em linha própria)
# Copie para river-unifi-bridge.env e ajuste; chmod 600 no arquivo real.

# ── 1. river ──────────────────────────────
RIVER_NAME=river-office
NUT_HOST=127.0.0.1
NUT_PORT=3493
NUT_UPS=river-office

# ── 2. unifi ──────────────────────────────
# vazio até a Fase 3 (PoC UniFi)

# ── 3. bridge ─────────────────────────────
POLL_INTERVAL_SECONDS=2

# ── 4. alarms ─────────────────────────────
# Defaults com fonte (docs/PESQUISA_PARAMETROS_UPS_20260831.md):
# 6=apcupsd ONBATTERYDELAY · 0=restauração imediata (NUT/apcupsd)
# 15=NUT upsmon DEADTIME · 30=fallback lowbatt do usbhid-ups
POWER_LOSS_DELAY_SECONDS=6
RESTORE_DELAY_SECONDS=0
COMM_LOSS_DELAY_SECONDS=15
LOW_BATTERY_PERCENT=30

# ── 5. ui api (§7A) ───────────────────────
UI_API_ENABLED=1
UI_API_PORT=35493
HISTORY_RETENTION_DAYS=7

# ── 6. proteção udr7 — ESPELHO da instância `udr7` (desde a 0.3.0; runbook docs/guides/2026-09-03-1710-runbook-protecao-udr7-por-instancia.md)
# Desde a 0.3.0 os dispositivos protegidos são INSTÂNCIAS em
# <estado>/devices.json, criadas e editadas pelo app (Ajustes → Dispositivos
# protegidos). No PRIMEIRO boot da 0.3.0 este bloco é lido UMA vez e vira a
# instância `udr7`; depois disso a instância é a verdade e estas chaves são
# só um espelho dela (todo PUT pelo app as reescreve; o boot nunca escreve
# aqui). Três chaves NÃO são da instância e continuam sendo lidas daqui:
#   UDR7_ARM_ALLOWED    — a trava GLOBAL de armamento. Desde a 0.8.0 é o interruptor
#                         "Permitir armar a proteção" em Ajustes › Travas (com
#                         confirmação, aplica a quente); aqui é só o espelho dele;
#   UDR7_EXPECTED_SERIAL e UDR7_CUTOFF_PERCENT — são do River (um só para todas
#   as instâncias); no app ficam em Ajustes → River.
# Nasce em ENSAIO: nada é enviado ao console. Armar = ligar a trava em Ajustes ›
# Travas, desligar o modo ensaio na folha do dispositivo e confirmar.
# Valores 0 = "não configurado" (a política bloqueia).
# Fontes: 22 = ssh_config(5) Port; 6 s = ANALOGIA apcupsd ONBATTERYDELAY; 3 tentativas = PROVISÓRIO;
# corte/limiar sem default por desenho (medidos no runbook: H15/H17); minutos desligados até confirmar unidade.
PROTECT_UDR7=0
PROTECT_DRY_RUN=1
UDR7_ARM_ALLOWED=0
UDR7_SSH_HOST=
UDR7_SSH_PORT=22
UDR7_SSH_USER=root
UDR7_SSH_KEY=
UDR7_EXPECTED_SERIAL=
UDR7_CUTOFF_PERCENT=0
UDR7_SHUTDOWN_PERCENT=0
UDR7_DISCHARGE_SECONDS_PER_PCT=0
UDR7_RUNTIME_MINUTES=0
UDR7_MIN_OUTAGE_SECONDS=0
UDR7_CONFIRM_SECONDS=6
UDR7_RETRY_MAX=3
UDR7_WOL_MAC=
# Nome do dispositivo nos relatórios e gráficos do app (1-32 caracteres).
# Pode ser trocado com a proteção armada — não é configuração de proteção.
UDR7_NAME=UDR7

# ── 7. o River como APARELHO (desde a 0.4.0/0.5.0) ─────────────────────────
# Consumo por tomada vem pela porta serial do MESMO cabo: o perfil de no-break
# não publica potência (medido, e confirmado no driver oficial do NUT).
# `auto` procura a porta e só aceita o aparelho cuja série bate com a do no-break.
RIVER_SERIAL_ENABLED=1
RIVER_SERIAL_PORT=auto
# Quem sobe, vigia e para o leitor e o servidor do no-break: 1 = o nosso serviço
# (é o que permite emprestar o cabo ao aplicativo da EcoFlow sem senha, e o que
# faz a leitura voltar sozinha depois de um reinício sem ninguém logado).
RIVER_NUT_MANAGED=1
# Trava do desligamento do próprio River — corta a energia de TUDO o que estiver
# ligado nele. Desde a 0.8.0 é o interruptor "Permitir desligar o River" em
# Ajustes › Travas (com confirmação, aplica a quente); aqui é só o espelho dele.
RIVER_POWEROFF_ALLOWED=0

# ── 8. a ponte publicando no NUT (desde a 0.7.0) ───────────────────────────
# O serviço passa a ser TAMBÉM um driver do NUT: publica um aparelho com tudo o
# que ele sabe do River (bateria, autonomia, situação, potência total, watts por
# tomada, frequência, temperatura) e um aparelho por dispositivo protegido. É por
# aqui que o Home Assistant recebe o mesmo que o aplicativo mostra.
RIVER_NUT_PUBLICA=1
# Como o aparelho do River se chama no NUT. NÃO pode ser igual a NUT_UPS: a
# proteção tem de ler o leitor de fábrica, e não o que nós mesmos escrevemos —
# o serviço recusa subir se os dois coincidirem.
RIVER_NUT_APARELHO=river-bridge
# Trava das ordens dadas À MÃO num dispositivo protegido (desligar, reiniciar),
# pelo aplicativo ou pelo Home Assistant. Terceira trava da casa, pelo mesmo
# motivo das outras duas: é ato destrutivo num aparelho de produção. Desde a
# 0.8.0 é o interruptor "Permitir mandar nos dispositivos" em Ajustes › Travas.
# Fechada, a ordem nem é oferecida — a proteção automática segue valendo, com a
# trava dela (UDR7_ARM_ALLOWED).
DEVICE_CMD_ALLOWED=0
# O cabo do River é UM só, e o aplicativo da EcoFlow também o quer. Ligado (o
# padrão desde a 0.8.0), o serviço larga o cabo quando aquele aplicativo abre e
# retoma quando ele fecha — sem botão nenhum: o dono só vê o aviso na tela. Com
# proteção armada o cabo NÃO é largado (seria ficar cego para a queda com o
# desligamento automático ligado). 0 desliga o automático: aí o cabo só muda de
# mão pela API local (POST /v1/river/cabo).
RIVER_CABO_AUTOMATICO=1
