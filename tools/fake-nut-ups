#!/usr/bin/env python3
"""fake-nut-ups — NUT (upsd) simulator for development without real hardware.

Spec §19. Speaks the read-only subset of the NUT protocol (LIST VAR, GET VAR,
USERNAME/PASSWORD, LOGOUT) over TCP. Scenarios are deterministic timelines so
integration tests and UI fixtures are reproducible.

Usage:
    ./fake-nut-ups --scenario power-loss [--port 3493] [--ups river-office]
    ./fake-nut-ups --scenario online --die-after 10   # closes to simulate COMM_LOST

Stdlib only. Saída do processo em pt-BR; código comentado em inglês.
"""

from __future__ import annotations

import argparse
import socketserver
import sys
import time

# Synthetic by construction: driver.name/driver.version identify the simulator so the
# UDR7 protection policy (src/river_unifi_bridge/protect.py) always refuses to act on
# it — Fase 3'-EXP fence M1. battery.charge.low is a simulated Discharge Limit.
BASE_VARS = {
    "device.mfr": "EcoFlow",
    "device.model": "RIVER 3 Plus",
    "device.serial": "SIM0001",
    "driver.name": "fake-nut-ups",
    "driver.version": "fake-nut-ups",
    "battery.charge.low": "10",
}

START = time.monotonic()


def _elapsed() -> float:
    return time.monotonic() - START


def scenario_online(_t: float) -> dict[str, str]:
    return {
        **BASE_VARS,
        "ups.status": "OL CHRG",
        "battery.charge": "87",
        "battery.runtime": "3600",
        "ups.load": "12",
        "input.voltage": "230.0",
        "output.voltage": "230.0",
        "ups.realpower": "45",
    }


def scenario_power_loss(t: float) -> dict[str, str]:
    """5 s on line power, then on battery, draining 1%/5s from 87%."""
    if t < 5:
        return scenario_online(t)
    charge = max(5, 87 - int((t - 5) / 5))
    status = "OB DISCHRG" if charge > 15 else "OB DISCHRG LB"
    return {
        **BASE_VARS,
        "ups.status": status,
        "battery.charge": str(charge),
        "battery.runtime": str(charge * 40),
        "ups.load": "12",
        "output.voltage": "230.0",
        "ups.realpower": "45",
    }


def scenario_low_battery(t: float) -> dict[str, str]:
    vars_ = scenario_power_loss(t + 5)  # skip the online prelude
    vars_["battery.charge"] = str(max(5, 14 - int(t / 5)))
    vars_["ups.status"] = "OB DISCHRG LB"
    return vars_


def scenario_overload(_t: float) -> dict[str, str]:
    vars_ = scenario_online(_t)
    vars_["ups.status"] = "OL OVER"
    vars_["ups.load"] = "110"
    return vars_


def scenario_instavel(t: float) -> dict[str, str]:
    """Alternating grid: 40 s online / 35 s on battery, forever — generates a
    steady stream of POWER_LOSS/POWER_RESTORED events (UI scroll testing) and
    a saw-tooth battery curve for the charts."""
    cycle = t % 75.0
    if cycle < 40:
        vars_ = scenario_online(t)
        charge = min(100, 60 + int(cycle))
        vars_["battery.charge"] = str(charge)
        vars_["ups.realpower"] = str(40 + int(cycle % 12))
        return vars_
    drop = int((cycle - 40) / 3)
    charge = max(30, 90 - drop)
    return {
        **BASE_VARS,
        "ups.status": "OB DISCHRG",
        "battery.charge": str(charge),
        "battery.runtime": str(charge * 40),
        "ups.load": "14",
        "output.voltage": "229.5",
        "ups.realpower": str(48 + drop),
    }


APAGAO_GRID_SECONDS = 20.0
APAGAO_OUTAGE_SECONDS = 100.0
APAGAO_CYCLE_SECONDS = APAGAO_GRID_SECONDS + APAGAO_OUTAGE_SECONDS + 20.0  # 140 s
APAGAO_CHARGE_START = 40.0
APAGAO_CHARGE_END = 3.0


def scenario_apagao(t: float) -> dict[str, str]:
    """Fase 3'-EXP rehearsal: 20 s on grid, a 100 s outage draining 40 % -> 3 %
    (no LB — the River never raises it, NUT issue #3068), then 20 s on grid.
    Long enough for the protection policy to fire in dry-run with defaults."""
    cycle = t % APAGAO_CYCLE_SECONDS
    if cycle < APAGAO_GRID_SECONDS or cycle >= APAGAO_GRID_SECONDS + APAGAO_OUTAGE_SECONDS:
        vars_ = scenario_online(t)
        vars_["battery.charge"] = str(int(APAGAO_CHARGE_START))
        vars_["battery.runtime"] = str(int(APAGAO_CHARGE_START * 40))
        return vars_
    elapsed = cycle - APAGAO_GRID_SECONDS
    span = APAGAO_CHARGE_START - APAGAO_CHARGE_END
    charge = max(APAGAO_CHARGE_END, APAGAO_CHARGE_START - span * elapsed / APAGAO_OUTAGE_SECONDS)
    return {
        **BASE_VARS,
        "ups.status": "OB DISCHRG",
        "battery.charge": str(int(charge)),
        "battery.runtime": str(int(charge) * 40),
        "ups.load": "14",
        "output.voltage": "229.5",
        "ups.realpower": "52",
    }


SCENARIOS = {
    "online": scenario_online,
    "power-loss": scenario_power_loss,
    "low-battery": scenario_low_battery,
    "overload": scenario_overload,
    "instavel": scenario_instavel,
    "apagao": scenario_apagao,
}


class Handler(socketserver.StreamRequestHandler):
    def handle(self) -> None:
        ups = self.server.ups_name  # type: ignore[attr-defined]
        scenario = self.server.scenario  # type: ignore[attr-defined]
        while True:
            raw = self.rfile.readline()
            if not raw:
                return
            parts = raw.decode("utf-8", "replace").split()
            if not parts:
                continue
            cmd = parts[0].upper()
            if cmd == "LOGOUT":
                self.wfile.write(b"OK Goodbye\n")
                return
            if cmd in ("USERNAME", "PASSWORD"):
                self.wfile.write(b"OK\n")
                continue
            if cmd == "LIST" and len(parts) >= 2 and parts[1].upper() == "UPS":
                # HA's NUT integration discovers UPSs via LIST UPS first.
                out = ["BEGIN LIST UPS",
                       f'UPS {ups} "EcoFlow RIVER 3 Plus (simulado)"',
                       "END LIST UPS"]
                self.wfile.write(("\n".join(out) + "\n").encode("utf-8"))
                continue
            if cmd == "LIST" and len(parts) >= 3 and parts[1].upper() == "VAR":
                if parts[2] != ups:
                    self.wfile.write(b"ERR UNKNOWN-UPS\n")
                    continue
                vars_ = scenario(_elapsed())
                out = [f"BEGIN LIST VAR {ups}"]
                out += [f'VAR {ups} {name} "{value}"' for name, value in vars_.items()]
                out.append(f"END LIST VAR {ups}")
                self.wfile.write(("\n".join(out) + "\n").encode("utf-8"))
                continue
            if cmd == "GET" and len(parts) >= 4 and parts[1].upper() == "VAR":
                vars_ = scenario(_elapsed())
                name = parts[3]
                if parts[2] != ups or name not in vars_:
                    self.wfile.write(b"ERR VAR-NOT-SUPPORTED\n")
                else:
                    self.wfile.write(f'VAR {ups} {name} "{vars_[name]}"\n'.encode())
                continue
            self.wfile.write(b"ERR UNKNOWN-COMMAND\n")


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


def main() -> int:
    parser = argparse.ArgumentParser(description="Simulador NUT (spec §19)")
    parser.add_argument("--port", type=int, default=3493)
    parser.add_argument(
        "--host", default="127.0.0.1",
        help="endereço de escuta (0.0.0.0 para servir a LAN — Fase 2/HA; nunca internet)",
    )
    parser.add_argument("--ups", default="river-office")
    parser.add_argument("--scenario", choices=sorted(SCENARIOS), default="online")
    parser.add_argument(
        "--die-after", type=float, default=0,
        help="segundos até encerrar o servidor (0 = nunca; simula COMM_LOST)",
    )
    args = parser.parse_args()

    server = Server((args.host, args.port), Handler)
    server.ups_name = args.ups  # type: ignore[attr-defined]
    server.scenario = SCENARIOS[args.scenario]  # type: ignore[attr-defined]
    port = server.server_address[1]
    print(f"fake-nut-ups: cenário={args.scenario} ups={args.ups} host={args.host} porta={port}", flush=True)

    if args.die_after > 0:
        import threading

        threading.Timer(args.die_after, server.shutdown).start()
    try:
        server.serve_forever(poll_interval=0.2)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    print("fake-nut-ups: encerrado", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
